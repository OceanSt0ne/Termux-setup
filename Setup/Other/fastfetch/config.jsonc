{
  "$schema": "https://github.com",
  "logo": {
    "type": "data",
    "source": "\n⠀⠀⠀⠀⠀⠀⠀⠀⠀⡔⠠⢤⣄⡀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀\n⡴⠒⠒⠒⠒⠒⠶⠦⠄⢹⣄⠀⠀⠑⠄⣀⡠⠤⠴⠒⠒⠒⠀⠀\n⢇⠀⠀⠀⠀⠀⠀⠐⠋⠀⠒⠂⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢠⠀\n⠈⢆⠀⠀⠀⠀⡤⠤⣄⠀⠀⠀⠀⡤⠤⢄⠀⠀⠀⠀⠀⣠⠃⠀\n⠀⡀⠑⢄⡀⡜⠀⡜⠉⡆⠀⠀⠀⡎⠙⡄⠳⡀⢀⣀⣜⠁⠀⠀\n⠀⠹⣍⠑⠀⡇⠀⢣⣰⠁⠀⠀⠀⠱⣠⠃⠀⡇⠁⣠⠞⠀⠀⠀\n⠀⠀⠀⡇⠔⣦⠀⠀⠀⠈⣉⣀⡀⠀⠀⠰⠶⠖⠘⢧⠀⠀⠀⠀\n⠀⠀⠰⠤⠐⠤⣀⡀⠀⠈⠑⣄⡁⠀⡀⣀⠴⠒⠀⠒⠃⠀⠀⠀\n⠀⠀⠀⠀⠀⠀⠘⢯⡉⠁⠀⠀⠀⠀⠉⢆⠀⠀⠀⠀⠀⠀⠀⠀\n⠀⠀⠀⠀⠀⠀⢀⣞⡄⠀⠀⠀⠀⠀⠀⠈⡆⠀⠀⠀⠀⠀⠀⠀",
    "color": {
      "1": "magenta"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": " ──> "
  },
  "modules": [
    // Отступ сверху
    "break",
    {
      "type": "title",
      "key": "    ฅ•ω•ฅ Юзеp",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "magenta"
      }
    },
    "break",
    {
      "type": "custom",
      "format": " OwO Окpужение"
    },
    {
      "type": "os",
      "key": "├─   Платфоpма"
    },
    {
      "type": "kernel",
      "key": "├─  Ядpышко",
      "format": "Linux 6.1.175"
    },
    {
      "type": "wm",
      "key": "├─   Окошки"
    },
    {
      "type": "terminal",
      "key": "└─  Теpминальчик"
    },
    "break",
    {
      "type": "custom",
      "format": " Железяки"
    },
    {
      "type": "cpu",
      "key": "├─  ЦПешка",
